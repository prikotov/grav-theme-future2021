{# ===========================================
   SEO & META TEMPLATE
   =========================================== #}
<meta charset="utf-8"/>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>

{# -------------------------
   Title
   ------------------------- #}
{% set meta_title = title is defined ? title ~ ' | ' ~ site.title : site.title %}
{% if meta_title %}
<title>{{ meta_title|e }}</title>
<meta itemprop="name" content="{{ meta_title|e }}">
<meta property="og:title" content="{{ meta_title|e }}">
<meta name="twitter:title" content="{{ meta_title|e }}">
{% endif %}

{# -------------------------
   Canonical & URLs
   ------------------------- #}
   {# Canonical URL #}
{% set current_query = uri.query() %}
{% set use_current_url_for_social_preview = current_query and ('utm_source=tg' in current_query or 'utm_source=telegram' in current_query) %}
{% set canonical_url = page.url(true, true) %}
{% if use_current_url_for_social_preview %}
  {% set canonical_url = canonical_url ~ '?' ~ current_query %}
{% endif %}

{% if canonical_url %}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta name="twitter:url" content="{{ canonical_url }}">
{% endif %}

{# Optional page-level hreflang links. Example frontmatter:
   alternates:
     - hreflang: ru
       href: https://example.com/page
     - hreflang: en
       href: https://example.com/page-en
     - hreflang: x-default
       href: https://example.com/page
#}
{% for alternate in page.header.alternates|default([]) %}
  {% set alternate_lang = alternate.hreflang|default(alternate.lang|default(null)) %}
  {% set alternate_href = alternate.href|default(alternate.url|default(null)) %}
  {% if alternate_lang and alternate_href %}
<link rel="alternate" hreflang="{{ alternate_lang|e }}" href="{{ alternate_href|e }}">
  {% endif %}
{% endfor %}

{# -------------------------
   Description
   ------------------------- #}
{# Description #}
{% set header_description = page.header.metadata.description|default(null) %}
{% set meta_description = header_description ?: (page.home()
    ? (site.metadata.description ?: site.title)
    : (page.summary ?: site.metadata.description ?: site.title)) %}

{% if meta_description %}
<meta name="description" content="{{ meta_description|striptags|trim|truncate(150)|raw }}">
<meta property="og:description" content="{{ meta_description|striptags|trim|truncate(150)|raw }}">
<meta name="twitter:description" content="{{ meta_description|striptags|trim|truncate(150)|raw }}">
<meta itemprop="description" content="{{ meta_description|striptags|trim|truncate(150)|raw }}">
{% endif %}

{# -------------------------
   Featured Image
   ------------------------- #}
{% if image %}
{% set social_preview_image_base_url = page.header.social_preview_image_base_url|default(theme_config.social_preview_image_base_url|default(''))|trim('/') %}
{% set social_preview_image_query = page.header.social_preview_image_query|default(theme_config.social_preview_image_query|default(''))|trim('?& ') %}
{% set image_path = image.url %}
{% if image_path starts with 'http://' or image_path starts with 'https://' %}
  {% set image_url = image_path %}
{% elseif social_preview_image_base_url %}
  {% set image_url = social_preview_image_base_url ~ '/' ~ image_path|trim('/') %}
{% else %}
  {% set image_url = url(image_path, true) %}
{% endif %}
{% if social_preview_image_query %}
  {% set image_url = image_url ~ ('?' in image_url ? '&' : '?') ~ social_preview_image_query %}
{% endif %}
<meta property="og:image" content="{{ image_url }}">
<meta property="og:image:secure_url" content="{{ image_url }}">
{% if img_width %}<meta property="og:image:width" content="{{ img_width }}">{% endif %}
{% if img_height %}<meta property="og:image:height" content="{{ img_height }}">{% endif %}
<meta name="twitter:image" content="{{ image_url }}">
<meta itemprop="image" content="{{ image_url }}">
{% endif %}

{# -------------------------
 Social Media Defaults
 ------------------------- #}
<meta property="og:type" content="{{ page.template == 'item' ? 'article' : 'website' }}">
<meta property="og:site_name" content="{{ site.title|e }}">
<meta name="twitter:card" content="summary_large_image">
{# Twitter site handle #}
{% set social_items = theme_config.social|default([]) %}
{% if social_items is not empty %}
 {% for item in social_items %}
  {% if item.name|lower == 'twitter' %}
<meta name="twitter:site" content="{{ item.url }}">
  {% endif %}
 {% endfor %}
{% endif %}

{# -------------------------
   Structured Data (JSON-LD)
   ------------------------- #}
{% set jsonld_taxonomy_authors = page.taxonomy.author|default([]) %}
{% set jsonld_author_name = jsonld_taxonomy_authors|first %}
{% if not jsonld_author_name %}
  {% set jsonld_author_name = page.header.metadata.author|default(null) %}
{% endif %}
{% if not jsonld_author_name %}
  {% set jsonld_author_name = page.header.author|default(null) %}
{% endif %}
{% if not jsonld_author_name %}
  {% set jsonld_author_name = site.author.name|default(null) %}
{% endif %}
{% if not jsonld_author_name %}
  {% set jsonld_author_name = 'Дмитрий Прикотов' %}
{% endif %}
{% set jsonld_language = page.header.lang|default(grav.language.getActive ?: grav.config.site.default_lang ?: config.system.languages.default_lang ?: 'ru') %}
{% set jsonld_description = meta_description|striptags|trim|truncate(150) %}
{% set jsonld_date_modified = page.header.sitemap.lastmod|default(null) %}
{% if not jsonld_date_modified %}
  {% set jsonld_date_modified = page.modified ?: page.date %}
{% endif %}
<script type="application/ld+json">
{{ {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': page.url(true),
  },
  headline: title|e,
  image: image ? image_url : '',
  datePublished: page.date|date('c'),
  dateModified: jsonld_date_modified|date('c'),
  inLanguage: jsonld_language,
  wordCount: page.content|wordcount,
  author: {
    '@type': 'Person',
    name: jsonld_author_name,
  },
  description: jsonld_description,
}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}
</script>

{# -------------------------
   Custom metadata only (excludes common duplicates)
   ------------------------- #}
{% for meta in page.metadata %}
  {% if meta.name and meta.name not in ['description', 'generator', 'viewport', 'author', 'keywords'] %}
<meta name="{{ meta.name|e }}" content="{{ meta.content|e }}">
  {% elseif meta.http_equiv and meta.http_equiv != 'X-UA-Compatible' %}
<meta http-equiv="{{ meta.http_equiv|e }}" content="{{ meta.content|e }}">
  {% elseif meta.property and meta.property not in ['og:title', 'og:description', 'og:image', 'og:url', 'og:type', 'og:site_name'] %}
<meta property="{{ meta.property|e }}" content="{{ meta.content|e }}">
  {% endif %}
{% endfor %}
